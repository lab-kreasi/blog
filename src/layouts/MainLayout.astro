---
// src/layouts/MainLayout.astro
const { title = "Blog Lab Kreasi" } = Astro.props;
import '../style/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <nav class="bg-white border-b sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold tracking-tighter text-indigo-600">LAB KREASI</a>
        <div class="space-x-6 text-sm font-medium">
          <a href="/" class="hover:text-indigo-600">Beranda</a>
          <a href="/tentang" class="hover:text-indigo-600">Tentang</a>
        </div>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4 py-10">
      <slot /> </main>

    <footer class="border-t mt-20 py-10 text-center text-slate-500 text-sm">
      © 2026 Blog Lab Kreasi - Dibangun dengan Astro & Sanity
    </footer>
  </body>
</html>